# Copia este archivo a .env
# Groq gratis: https://console.groq.com/keys
GROQ_API_KEY=
# Modelo rápido (recomendado). El 70b es más lento.
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL_FAST=llama-3.1-8b-instant

USER_NAME=Danny
PORT=8787

# 0.0.0.0 permite controlar Jarvis desde el teléfono (misma WiFi)
HOST=0.0.0.0

VOICE_LANG=es-MX
# Voz Edge TTS (clara). Otras: es-MX-JorgeNeural, es-ES-ElviraNeural, es-MX-MarinaNeural
VOICE_NAME=es-MX-DaliaNeural

# Opcional: control remoto desde Telegram (gratis)
# 1) Habla con @BotFather en Telegram → /newbot
# 2) Pega el token aquí
# Opcional: control remoto desde Telegram (gratis)
# 1) Habla con @BotFather en Telegram → /newbot
# 2) Pega el token aquí
TELEGRAM_BOT_TOKEN=

# Proyectos (también en data/projects.json)
# PROJECT_PORTFOLIO=C:\Git\Personal\Portfolio
# PROJECT_ECOKINAL=C:\Git\...

