{
  "name": "jarvis",
  "version": "1.1.0",
  "private": true,
  "description": "Asistente de voz local estilo Jarvis para Windows",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --no-open",
    "app": "electron .",
    "app:dev": "electron .",
    "greet": "node scripts/greet-once.js",
    "install-startup": "powershell -ExecutionPolicy Bypass -File scripts/install-startup.ps1",
    "uninstall-startup": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-startup.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^37.2.0"
  }
}
